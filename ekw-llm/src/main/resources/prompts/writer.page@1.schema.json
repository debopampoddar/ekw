{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "description",
    "sections",
    "keep_sections",
    "synthesis",
    "concepts",
    "read",
    "not_read",
    "evidence_requests"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "exactly one sentence"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading",
          "paragraphs",
          "diagram_evidence_id"
        ],
        "properties": {
          "heading": {
            "type": "string"
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "evidence"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^E[1-9][0-9]*$"
                    }
                  }
                }
              }
            }
          },
          "diagram_evidence_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "keep_sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "synthesis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 60
      }
    },
    "read": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_read": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_requests": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    }
  }
}
